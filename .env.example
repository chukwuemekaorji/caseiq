# Postgres connection string used by the running app — Supabase's "Transaction pooler" string (port 6543)
DATABASE_URL=postgres://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres

# Direct (non-pooled) connection — used only by `npm run db:push` for schema migrations (port 5432)
DIRECT_URL=postgres://postgres:password@db.xxxx.supabase.co:5432/postgres

# Anthropic API key for the /api/anthropic route (server-side only, never exposed to the browser)
ANTHROPIC_API_KEY=sk-ant-...
